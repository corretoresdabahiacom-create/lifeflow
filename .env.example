# Somente nomes de variáveis. NUNCA colocar valores reais neste arquivo.
# Lista completa e instruções: docs/ENVIRONMENT.md

# Frontend (apps/web/.env.local) — identificadores públicos do app web Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=
VITE_USE_EMULATORS=

# Worker (workers/api/wrangler.toml [vars] ou .dev.vars) — nenhum destes é segredo na Fase 1
FIREBASE_PROJECT_ID=
ALLOWED_ORIGIN=

# Fases futuras (secrets do Worker; só ativar com autorização de uso)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
STT_PROVIDER=
STT_MODEL=
STT_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
