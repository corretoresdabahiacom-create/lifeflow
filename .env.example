# Somente nomes de variáveis. NUNCA colocar valores reais neste arquivo.
# Valores reais ficam em secrets do ambiente (Cloudflare, GitHub Actions, Supabase).
# Lista completa e instruções de ativação: docs/ENVIRONMENT.md

# Supabase (publishable key é pública; service_role NÃO é usada em requisições de usuário)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Provedores (somente ativados com autorização explícita de uso)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
STT_PROVIDER=
STT_MODEL=
STT_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
