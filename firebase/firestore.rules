rules_version = '2';

// Segurança de dados do LifeFlow (equivalente à RLS do contrato original; ver DECISIONS D-004).
// Princípios:
//  - negado por padrão;
//  - dados pessoais ficam sob users/{uid} e só o dono acessa;
//  - permissões separadas por operação (get, list, create, update, delete);
//  - o campo `uid` do documento deve ser igual ao do caminho e é imutável;
//  - nenhuma regra genérica permissiva.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Validadores reutilizáveis (módulo financeiro, Fase 2) ----
    function isText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function isNullOrText(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function isDocId(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{1,80}$');
    }
    function isNullOrDocId(v) {
      return v == null || isDocId(v);
    }
    function isDateText(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isNullOrDate(v) {
      return v == null || isDateText(v);
    }
    // Centavos inteiros, limitados a R$ 1 bilhão.
    function isCents(v) {
      return v is int && v >= -100000000000 && v <= 100000000000;
    }
    function isPositiveCents(v) {
      return v is int && v > 0 && v <= 100000000000;
    }
    function isNullOrTime(v) {
      return v == null || (v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }
    function isNullOrLink(v) {
      return v == null || (v is string && v.size() <= 500 && v.matches('^https?://[^ ]+$'));
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- Perfil: users/{uid} ----
    match /users/{uid} {

      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'displayName', 'locale', 'timezone', 'currency', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['uid', 'displayName', 'locale', 'timezone', 'currency', 'createdAt', 'updatedAt'])
          && d.uid == uid
          && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 80
          && d.locale is string && d.locale.matches('^[a-z]{2}(-[A-Z]{2})?$')
          && d.timezone is string && d.timezone.size() > 0 && d.timezone.size() <= 64
          && d.currency is string && d.currency.matches('^[A-Z]{3}$')
          && d.createdAt is string
          && d.updatedAt is string;
      }

      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validProfile();
      allow update: if isOwner(uid)
        && validProfile()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      // A exclusão de conta é um fluxo controlado (fase futura), não uma operação do cliente.
      allow delete: if false;

      // ---- Preferências: users/{uid}/preferences/{key} (documento único "app") ----
      match /preferences/{key} {

        function validPreferences() {
          let d = request.resource.data;
          return key == 'app'
            && d.keys().hasOnly(['uid', 'theme', 'confirmCreations', 'quietHoursStart', 'quietHoursEnd', 'updatedAt'])
            && d.keys().hasAll(['uid', 'theme', 'confirmCreations', 'quietHoursStart', 'quietHoursEnd', 'updatedAt'])
            && d.uid == uid
            && d.theme in ['light', 'dark', 'system']
            && d.confirmCreations is bool
            && d.quietHoursStart is string && d.quietHoursStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && d.quietHoursEnd is string && d.quietHoursEnd.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && d.updatedAt is string;
        }

        // Limites de automação do assistente (Fase 4): documento "ai".
        function validAiSettings() {
          let d = request.resource.data;
          return key == 'ai'
            && d.keys().hasOnly(['uid', 'autoActionsPerDay', 'autoValueLimitCents', 'confirmAboveCents', 'updatedAt'])
            && d.keys().hasAll(['uid', 'autoActionsPerDay', 'autoValueLimitCents', 'confirmAboveCents', 'updatedAt'])
            && d.uid == uid
            && d.autoActionsPerDay is int && d.autoActionsPerDay >= 0 && d.autoActionsPerDay <= 100
            && d.autoValueLimitCents is int && d.autoValueLimitCents >= 0 && d.autoValueLimitCents <= 10000000
            && d.confirmAboveCents is int && d.confirmAboveCents >= 0 && d.confirmAboveCents <= 10000000
            && d.updatedAt is string;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && (validPreferences() || validAiSettings());
        allow update: if isOwner(uid)
          && (validPreferences() || validAiSettings())
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(uid);
      }

      // ---- Consentimentos: users/{uid}/consents/audio (envio de áudio para transcrição) ----
      match /consents/{key} {
        function validConsent() {
          let d = request.resource.data;
          return key == 'audio'
            && d.keys().hasOnly(['uid', 'granted', 'updatedAt'])
            && d.keys().hasAll(['uid', 'granted', 'updatedAt'])
            && d.uid == uid
            && d.granted is bool
            && d.updatedAt is string;
        }
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validConsent();
        allow update: if isOwner(uid) && validConsent() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(uid);
      }

      // =====================================================================
      // Módulo financeiro (Fase 2). Valores sempre em centavos inteiros.
      // As regras garantem dono, formato e imutabilidade; NÃO há exclusão: o livro-razão
      // só muda por estorno (status posted -> voided). A consistência saldo x lançamentos
      // depende do Worker (commit atômico) e é conferida por GET /v1/reconcile.
      // =====================================================================

      // ---- Contas: users/{uid}/accounts/{docId} ----
      match /accounts/{docId} {
        function validAccount() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'name', 'type', 'initialBalanceCents', 'balanceCents', 'archived', 'createdAt', 'updatedAt', 'requestHash'])
            && d.keys().hasAll(['uid', 'name', 'type', 'initialBalanceCents', 'balanceCents', 'archived', 'createdAt', 'updatedAt', 'requestHash'])
            && isDocId(docId)
            && d.uid == uid
            && isText(d.name, 60)
            && d.type in ['checking', 'savings', 'cash', 'credit_card', 'investment']
            && isCents(d.initialBalanceCents)
            && d.balanceCents is int
            && d.archived is bool
            && d.createdAt is string
            && d.updatedAt is string
            && d.requestHash is string;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validAccount()
          && request.resource.data.balanceCents == request.resource.data.initialBalanceCents
          && request.resource.data.archived == false;
        allow update: if isOwner(uid) && validAccount()
          && !changedKeys().hasAny(['uid', 'type', 'initialBalanceCents', 'createdAt', 'requestHash']);
        allow delete: if false;
      }

      // ---- Categorias: users/{uid}/categories/{docId} ----
      match /categories/{docId} {
        function validCategory() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'name', 'kind', 'archived', 'createdAt', 'updatedAt', 'requestHash'])
            && d.keys().hasAll(['uid', 'name', 'kind', 'archived', 'createdAt', 'updatedAt', 'requestHash'])
            && isDocId(docId)
            && d.uid == uid
            && isText(d.name, 60)
            && d.kind in ['income', 'expense']
            && d.archived is bool
            && d.createdAt is string
            && d.updatedAt is string
            && d.requestHash is string;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validCategory() && request.resource.data.archived == false;
        allow update: if isOwner(uid) && validCategory()
          && !changedKeys().hasAny(['uid', 'kind', 'createdAt', 'requestHash']);
        allow delete: if false;
      }

      // ---- Lançamentos (livro-razão): users/{uid}/transactions/{docId} ----
      match /transactions/{docId} {
        function validTransaction() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'accountId', 'type', 'amountCents', 'signedCents', 'date', 'categoryId', 'description', 'notes', 'status', 'transferId', 'payableId', 'createdAt', 'updatedAt', 'voidedAt', 'requestHash', 'origin', 'aiActionId'])
            && d.keys().hasAll(['uid', 'accountId', 'type', 'amountCents', 'signedCents', 'date', 'categoryId', 'description', 'notes', 'status', 'transferId', 'payableId', 'createdAt', 'updatedAt', 'voidedAt', 'requestHash'])
            // Origem (manual/ia): opcional por compatibilidade; imutável após a criação (ver `update` abaixo).
            && (!('origin' in d) || d.origin in ['manual', 'ai'])
            && (!('aiActionId' in d) || isNullOrDocId(d.aiActionId))
            && isDocId(docId)
            && d.uid == uid
            && isDocId(d.accountId)
            && d.type in ['income', 'expense', 'transfer_out', 'transfer_in']
            && isPositiveCents(d.amountCents)
            && ((d.type in ['income', 'transfer_in'] && d.signedCents == d.amountCents)
                || (d.type in ['expense', 'transfer_out'] && d.signedCents == -d.amountCents))
            && isDateText(d.date)
            && isNullOrDocId(d.categoryId)
            && isText(d.description, 140)
            && isNullOrText(d.notes, 500)
            && d.status in ['posted', 'voided']
            && isNullOrDocId(d.transferId)
            && isNullOrDocId(d.payableId)
            && d.createdAt is string
            && d.updatedAt is string
            && (d.voidedAt == null || d.voidedAt is string)
            && d.requestHash is string;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        // O lançamento só pode ser criado "efetivado" e para uma conta que já existe (do próprio usuário).
        allow create: if isOwner(uid) && validTransaction()
          && request.resource.data.status == 'posted'
          && request.resource.data.voidedAt == null
          && exists(/databases/$(database)/documents/users/$(uid)/accounts/$(request.resource.data.accountId));
        // Duas únicas alterações: estorno (posted -> voided) ou edição de metadados.
        // Valor, conta, tipo, data e vínculos são imutáveis.
        allow update: if isOwner(uid) && validTransaction() && resource.data.status == 'posted'
          && (
            (request.resource.data.status == 'voided'
              && changedKeys().hasOnly(['status', 'voidedAt', 'updatedAt'])
              && request.resource.data.voidedAt is string)
            ||
            (request.resource.data.status == 'posted'
              && changedKeys().hasOnly(['description', 'notes', 'categoryId', 'updatedAt']))
          );
        allow delete: if false;
      }

      // ---- Transferências: users/{uid}/transfers/{docId} ----
      match /transfers/{docId} {
        function validTransfer() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'fromAccountId', 'toAccountId', 'amountCents', 'date', 'description', 'status', 'outTransactionId', 'inTransactionId', 'createdAt', 'updatedAt', 'voidedAt', 'requestHash'])
            && d.keys().hasAll(['uid', 'fromAccountId', 'toAccountId', 'amountCents', 'date', 'description', 'status', 'outTransactionId', 'inTransactionId', 'createdAt', 'updatedAt', 'voidedAt', 'requestHash'])
            && isDocId(docId)
            && d.uid == uid
            && isDocId(d.fromAccountId)
            && isDocId(d.toAccountId)
            && d.fromAccountId != d.toAccountId
            && isPositiveCents(d.amountCents)
            && isDateText(d.date)
            && isNullOrText(d.description, 140)
            && d.status in ['posted', 'voided']
            && isDocId(d.outTransactionId)
            && isDocId(d.inTransactionId)
            && d.createdAt is string
            && d.updatedAt is string
            && (d.voidedAt == null || d.voidedAt is string)
            && d.requestHash is string;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validTransfer()
          && request.resource.data.status == 'posted'
          && request.resource.data.voidedAt == null
          && exists(/databases/$(database)/documents/users/$(uid)/accounts/$(request.resource.data.fromAccountId))
          && exists(/databases/$(database)/documents/users/$(uid)/accounts/$(request.resource.data.toAccountId));
        allow update: if isOwner(uid) && validTransfer() && resource.data.status == 'posted'
          && request.resource.data.status == 'voided'
          && changedKeys().hasOnly(['status', 'voidedAt', 'updatedAt'])
          && request.resource.data.voidedAt is string;
        allow delete: if false;
      }

      // ---- Contas a pagar/receber: users/{uid}/payables/{docId} ----
      match /payables/{docId} {
        function validPayable() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'kind', 'description', 'amountCents', 'dueDate', 'accountId', 'categoryId', 'status', 'paidDate', 'paidAmountCents', 'transactionId', 'payCount', 'recurringId', 'createdAt', 'updatedAt', 'requestHash', 'payRequestHash'])
            && d.keys().hasAll(['uid', 'kind', 'description', 'amountCents', 'dueDate', 'accountId', 'categoryId', 'status', 'paidDate', 'paidAmountCents', 'transactionId', 'payCount', 'recurringId', 'createdAt', 'updatedAt', 'requestHash', 'payRequestHash'])
            && isDocId(docId)
            && d.uid == uid
            && d.kind in ['payable', 'receivable']
            && isText(d.description, 140)
            && isPositiveCents(d.amountCents)
            && isDateText(d.dueDate)
            && isNullOrDocId(d.accountId)
            && isNullOrDocId(d.categoryId)
            && d.status in ['open', 'paid', 'canceled']
            && d.payCount is int && d.payCount >= 0
            && isNullOrDocId(d.recurringId)
            && d.createdAt is string
            && d.updatedAt is string
            && d.requestHash is string
            && (d.payRequestHash == null || d.payRequestHash is string)
            // Paga = data, valor e lançamento preenchidos; não paga = tudo vazio.
            && (d.status == 'paid'
                ? (isDateText(d.paidDate) && isPositiveCents(d.paidAmountCents) && isDocId(d.transactionId))
                : (d.paidDate == null && d.paidAmountCents == null && d.transactionId == null));
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validPayable()
          && request.resource.data.status == 'open'
          && request.resource.data.payCount == 0;
        allow update: if isOwner(uid) && validPayable()
          && !changedKeys().hasAny(['uid', 'kind', 'createdAt', 'requestHash', 'recurringId']);
        allow delete: if false;
      }

      // ---- Recorrências: users/{uid}/recurring/{docId} ----
      match /recurring/{docId} {
        function validRecurring() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'kind', 'description', 'amountCents', 'frequency', 'startDate', 'endDate', 'accountId', 'categoryId', 'active', 'lastMaterializedThrough', 'createdAt', 'updatedAt', 'requestHash'])
            && d.keys().hasAll(['uid', 'kind', 'description', 'amountCents', 'frequency', 'startDate', 'endDate', 'accountId', 'categoryId', 'active', 'lastMaterializedThrough', 'createdAt', 'updatedAt', 'requestHash'])
            && isDocId(docId)
            && d.uid == uid
            && d.kind in ['payable', 'receivable']
            && isText(d.description, 140)
            && isPositiveCents(d.amountCents)
            && d.frequency in ['weekly', 'monthly', 'yearly']
            && isDateText(d.startDate)
            && isNullOrDate(d.endDate)
            && isNullOrDocId(d.accountId)
            && isNullOrDocId(d.categoryId)
            && d.active is bool
            && isNullOrDate(d.lastMaterializedThrough)
            && d.createdAt is string
            && d.updatedAt is string
            && d.requestHash is string;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validRecurring()
          && request.resource.data.lastMaterializedThrough == null;
        allow update: if isOwner(uid) && validRecurring()
          && !changedKeys().hasAny(['uid', 'kind', 'frequency', 'startDate', 'createdAt', 'requestHash']);
        allow delete: if false;
      }

      // =================== Agenda (Fase 3) ===================

      // ---- Eventos (série ou evento simples): users/{uid}/events/{docId} ----
      match /events/{docId} {
        function validEvent() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'title', 'kind', 'description', 'startDate', 'startTime', 'durationMin', 'timeZone', 'location', 'contact', 'link', 'notes', 'estimatedCostCents', 'reminders', 'recFrequency', 'recInterval', 'recWeekdays', 'recUntil', 'recCount', 'expenseTransactionId', 'createdAt', 'updatedAt', 'requestHash'])
            && d.keys().hasAll(['uid', 'title', 'kind', 'description', 'startDate', 'startTime', 'durationMin', 'timeZone', 'location', 'contact', 'link', 'notes', 'estimatedCostCents', 'reminders', 'recFrequency', 'recInterval', 'recWeekdays', 'recUntil', 'recCount', 'expenseTransactionId', 'createdAt', 'updatedAt', 'requestHash'])
            && isDocId(docId)
            && d.uid == uid
            && isText(d.title, 120)
            && d.kind in ['personal', 'professional', 'medical', 'family', 'meeting', 'trip', 'other']
            && isNullOrText(d.description, 1000)
            && isDateText(d.startDate)
            && isNullOrTime(d.startTime)
            && d.durationMin is int && d.durationMin >= 1 && d.durationMin <= 20160
            && isText(d.timeZone, 64)
            && isNullOrText(d.location, 200)
            && isNullOrText(d.contact, 200)
            && isNullOrLink(d.link)
            && isNullOrText(d.notes, 1000)
            && (d.estimatedCostCents == null || isPositiveCents(d.estimatedCostCents))
            && d.reminders is string && d.reminders.matches('^([0-9]{1,5}(,[0-9]{1,5}){0,4})?$')
            && (d.recFrequency == null || d.recFrequency in ['daily', 'weekly', 'monthly', 'yearly', 'custom'])
            && (d.recInterval == null || (d.recInterval is int && d.recInterval >= 1 && d.recInterval <= 99))
            && d.recWeekdays is string && d.recWeekdays.matches('^([0-6](,[0-6]){0,6})?$')
            && isNullOrDate(d.recUntil)
            && (d.recCount == null || (d.recCount is int && d.recCount >= 1 && d.recCount <= 1000))
            && isNullOrDocId(d.expenseTransactionId)
            && d.createdAt is string
            && d.updatedAt is string
            && d.requestHash is string && d.requestHash.size() <= 100;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validEvent() && request.resource.data.expenseTransactionId == null;
        allow update: if isOwner(uid) && validEvent()
          && !changedKeys().hasAny(['uid', 'createdAt', 'requestHash']);
        allow delete: if isOwner(uid);
      }

      // ---- Exceções de ocorrência: users/{uid}/eventExceptions/{docId} ----
      // Campos de sobrescrita são opcionais: ausente = herda da série; presente (inclusive null) = sobrescreve.
      match /eventExceptions/{docId} {
        function validException() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'seriesId', 'originalDate', 'canceled', 'createdAt', 'updatedAt', 'startDate', 'startTime', 'durationMin', 'title', 'kind', 'description', 'location', 'contact', 'link', 'notes', 'estimatedCostCents', 'reminders', 'expenseTransactionId'])
            && d.keys().hasAll(['uid', 'seriesId', 'originalDate', 'canceled', 'createdAt', 'updatedAt'])
            && isDocId(docId)
            && d.uid == uid
            && isDocId(d.seriesId)
            && isDateText(d.originalDate)
            && d.canceled is bool
            && d.createdAt is string
            && d.updatedAt is string
            && (!('startDate' in d) || isDateText(d.startDate))
            && (!('startTime' in d) || isNullOrTime(d.startTime))
            && (!('durationMin' in d) || (d.durationMin is int && d.durationMin >= 1 && d.durationMin <= 20160))
            && (!('title' in d) || isText(d.title, 120))
            && (!('kind' in d) || d.kind in ['personal', 'professional', 'medical', 'family', 'meeting', 'trip', 'other'])
            && (!('description' in d) || isNullOrText(d.description, 1000))
            && (!('location' in d) || isNullOrText(d.location, 200))
            && (!('contact' in d) || isNullOrText(d.contact, 200))
            && (!('link' in d) || isNullOrLink(d.link))
            && (!('notes' in d) || isNullOrText(d.notes, 1000))
            && (!('estimatedCostCents' in d) || d.estimatedCostCents == null || isPositiveCents(d.estimatedCostCents))
            && (!('reminders' in d) || (d.reminders is string && d.reminders.matches('^([0-9]{1,5}(,[0-9]{1,5}){0,4})?$')))
            && (!('expenseTransactionId' in d) || isNullOrDocId(d.expenseTransactionId));
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validException();
        allow update: if isOwner(uid) && validException()
          && !changedKeys().hasAny(['uid', 'seriesId', 'originalDate', 'createdAt']);
        allow delete: if isOwner(uid);
      }

      // ---- Tarefas: users/{uid}/tasks/{docId} ----
      match /tasks/{docId} {
        function validTask() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'title', 'description', 'priority', 'categoryId', 'dueDate', 'dueTime', 'status', 'reminderMinutes', 'completedAt', 'createdAt', 'updatedAt', 'requestHash'])
            && d.keys().hasAll(['uid', 'title', 'description', 'priority', 'categoryId', 'dueDate', 'dueTime', 'status', 'reminderMinutes', 'completedAt', 'createdAt', 'updatedAt', 'requestHash'])
            && isDocId(docId)
            && d.uid == uid
            && isText(d.title, 140)
            && isNullOrText(d.description, 1000)
            && d.priority in ['low', 'medium', 'high', 'urgent']
            && isNullOrDocId(d.categoryId)
            && isNullOrDate(d.dueDate)
            && isNullOrTime(d.dueTime)
            && (d.dueTime == null || d.dueDate != null)
            && d.status in ['pending', 'in_progress', 'completed', 'canceled']
            && (d.reminderMinutes == null || (d.reminderMinutes is int && d.reminderMinutes >= 0 && d.reminderMinutes <= 40320))
            && (d.reminderMinutes == null || d.dueDate != null)
            && (d.completedAt == null || d.completedAt is string)
            && (d.status == 'completed' || d.completedAt == null)
            && d.createdAt is string
            && d.updatedAt is string
            && d.requestHash is string && d.requestHash.size() <= 100;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validTask() && request.resource.data.completedAt == null
          && request.resource.data.status in ['pending', 'in_progress'];
        allow update: if isOwner(uid) && validTask()
          && !changedKeys().hasAny(['uid', 'createdAt', 'requestHash']);
        allow delete: if isOwner(uid);
      }

      // ---- Categorias de tarefa: users/{uid}/taskCategories/{docId} ----
      match /taskCategories/{docId} {
        function validTaskCategory() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'name', 'archived', 'createdAt', 'updatedAt', 'requestHash'])
            && d.keys().hasAll(['uid', 'name', 'archived', 'createdAt', 'updatedAt', 'requestHash'])
            && isDocId(docId)
            && d.uid == uid
            && isText(d.name, 60)
            && d.archived is bool
            && d.createdAt is string
            && d.updatedAt is string
            && d.requestHash is string;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validTaskCategory() && request.resource.data.archived == false;
        allow update: if isOwner(uid) && validTaskCategory()
          && !changedKeys().hasAny(['uid', 'createdAt', 'requestHash']);
        allow delete: if false;
      }

      // ---- Lembretes avulsos: users/{uid}/reminders/{docId} (imutáveis; só criar e excluir) ----
      match /reminders/{docId} {
        function validReminder() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'title', 'remindAt', 'createdAt', 'requestHash'])
            && d.keys().hasAll(['uid', 'title', 'remindAt', 'createdAt', 'requestHash'])
            && isDocId(docId)
            && d.uid == uid
            && isText(d.title, 140)
            && d.remindAt is string && d.remindAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$')
            && d.createdAt is string
            && d.requestHash is string;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validReminder();
        // Só título e horário mudam (o novo horário gera um novo aviso, pois a chave do aviso inclui `remindAt`).
        allow update: if isOwner(uid) && validReminder() && changedKeys().hasOnly(['title', 'remindAt']);
        allow delete: if isOwner(uid);
      }

      // ---- Notificações: users/{uid}/notifications/{docId} ----
      // Só o estado de leitura/dispensa muda; "dispensar" esconde, não apaga (evita regerar o aviso).
      match /notifications/{docId} {
        function validNotification() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'type', 'title', 'body', 'sourceType', 'sourceId', 'occurrenceKey', 'triggerAt', 'silent', 'read', 'readAt', 'dismissed', 'createdAt'])
            && d.keys().hasAll(['uid', 'type', 'title', 'body', 'sourceType', 'sourceId', 'occurrenceKey', 'triggerAt', 'silent', 'read', 'readAt', 'dismissed', 'createdAt'])
            && isDocId(docId)
            && d.uid == uid
            && d.type in ['event_reminder', 'task_reminder', 'task_overdue', 'payable_due', 'reminder']
            && isText(d.title, 200)
            && d.body is string && d.body.size() <= 300
            && d.sourceType in ['event', 'task', 'payable', 'reminder']
            && isDocId(d.sourceId)
            && isText(d.occurrenceKey, 120)
            && d.triggerAt is string
            && d.silent is bool
            && d.read is bool
            && (d.readAt == null || d.readAt is string)
            && d.dismissed is bool
            && d.createdAt is string;
        }

        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validNotification()
          && request.resource.data.read == false
          && request.resource.data.readAt == null
          && request.resource.data.dismissed == false;
        allow update: if isOwner(uid) && validNotification()
          && changedKeys().hasOnly(['read', 'readAt', 'dismissed'])
          && (resource.data.read == false || request.resource.data.read == true)
          && (resource.data.dismissed == false || request.resource.data.dismissed == true);
        allow delete: if false;
      }

      // ---- Assistente de IA (Fase 4) ----
      // Conversas e mensagens (texto). Mensagens são imutáveis; a conversa só avança `updatedAt`.
      match /aiConversations/{docId} {
        function validConversation() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'title', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['uid', 'title', 'createdAt', 'updatedAt'])
            && isDocId(docId)
            && d.uid == uid
            && isText(d.title, 60)
            && d.createdAt is string
            && d.updatedAt is string;
        }
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validConversation();
        allow update: if isOwner(uid) && validConversation() && changedKeys().hasOnly(['updatedAt']);
        allow delete: if isOwner(uid);

        match /messages/{messageId} {
          function validMessage() {
            let d = request.resource.data;
            return d.keys().hasOnly(['uid', 'conversationId', 'role', 'content', 'createdAt'])
              && d.keys().hasAll(['uid', 'conversationId', 'role', 'content', 'createdAt'])
              && isDocId(messageId)
              && d.uid == uid
              && d.conversationId == docId
              && d.role in ['user', 'assistant']
              && isText(d.content, 4000)
              && d.createdAt is string;
          }
          allow get: if isOwner(uid);
          allow list: if isOwner(uid);
          allow create: if isOwner(uid) && validMessage();
          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }

      // Ações propostas pela IA: nascem "pending"; só o estado e o resultado evoluem (nunca os parâmetros).
      match /aiActions/{docId} {
        function validAction() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'conversationId', 'messageId', 'tool', 'kind', 'financial', 'argsJson', 'argsHash', 'summary', 'amountCents', 'reinforced', 'status', 'resultNote', 'expiresAt', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['uid', 'conversationId', 'messageId', 'tool', 'kind', 'financial', 'argsJson', 'argsHash', 'summary', 'amountCents', 'reinforced', 'status', 'resultNote', 'expiresAt', 'createdAt', 'updatedAt'])
            && isDocId(docId)
            && d.uid == uid
            && isDocId(d.conversationId)
            && isDocId(d.messageId)
            && isText(d.tool, 40)
            && d.kind in ['create', 'update', 'delete']
            && d.financial is bool
            && d.argsJson is string && d.argsJson.size() <= 4500
            && d.argsHash is string && d.argsHash.size() == 64
            && isText(d.summary, 500)
            && (d.amountCents == null || isPositiveCents(d.amountCents))
            && d.reinforced is bool
            && d.status in ['pending', 'executing', 'done', 'failed', 'blocked', 'expired', 'rejected']
            && isNullOrText(d.resultNote, 300)
            && d.expiresAt is string
            && d.createdAt is string
            && d.updatedAt is string;
        }
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validAction() && request.resource.data.status == 'pending'
          && request.resource.data.resultNote == null;
        // Estados terminais não mudam mais; parâmetros, ferramenta e resumo são imutáveis.
        allow update: if isOwner(uid) && validAction()
          && resource.data.status in ['pending', 'executing']
          && changedKeys().hasOnly(['status', 'resultNote', 'updatedAt'])
          && (resource.data.status == 'pending' || request.resource.data.status in ['done', 'failed', 'blocked']);
        allow delete: if false;
      }

      // Trilha de auditoria: só cria; ninguém altera ou apaga.
      match /aiLogs/{docId} {
        function validLog() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'event', 'tool', 'actionId', 'argsHash', 'detail', 'conversationId', 'createdAt'])
            && d.keys().hasAll(['uid', 'event', 'tool', 'actionId', 'argsHash', 'detail', 'conversationId', 'createdAt'])
            && isDocId(docId)
            && d.uid == uid
            && d.event in ['proposed', 'auto_executed', 'confirmed', 'executed', 'failed', 'rejected', 'blocked', 'expired', 'unauthorized_tool', 'invalid_args', 'provider_error']
            && isNullOrText(d.tool, 60)
            && isNullOrDocId(d.actionId)
            && isNullOrText(d.argsHash, 64)
            && d.detail is string && d.detail.size() <= 300
            && isNullOrText(d.conversationId, 80)
            && d.createdAt is string;
        }
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validLog();
        allow update: if false;
        allow delete: if false;
      }

      // Consumo mensal e automação diária: contadores que só crescem.
      match /aiUsage/{docId} {
        function validUsage() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'messages', 'voiceSeconds', 'inputTokens', 'outputTokens', 'updatedAt'])
            && docId.matches('^[0-9]{4}-[0-9]{2}$')
            && d.uid == uid
            && d.updatedAt is string
            && (!('messages' in d) || (d.messages is int && d.messages >= 0))
            && (!('voiceSeconds' in d) || (d.voiceSeconds is int && d.voiceSeconds >= 0))
            && (!('inputTokens' in d) || (d.inputTokens is int && d.inputTokens >= 0))
            && (!('outputTokens' in d) || (d.outputTokens is int && d.outputTokens >= 0));
        }
        function onlyGrows(field) {
          return !(field in resource.data) || (field in request.resource.data && request.resource.data[field] >= resource.data[field]);
        }
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validUsage();
        allow update: if isOwner(uid) && validUsage()
          && onlyGrows('messages') && onlyGrows('voiceSeconds') && onlyGrows('inputTokens') && onlyGrows('outputTokens');
        allow delete: if false;
      }

      match /aiDaily/{docId} {
        function validDaily() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'autoActions', 'autoValueCents', 'updatedAt'])
            && isDateText(docId)
            && d.uid == uid
            && d.updatedAt is string
            && (!('autoActions' in d) || (d.autoActions is int && d.autoActions >= 0))
            && (!('autoValueCents' in d) || (d.autoValueCents is int && d.autoValueCents >= 0));
        }
        function dailyGrows(field) {
          return !(field in resource.data) || (field in request.resource.data && request.resource.data[field] >= resource.data[field]);
        }
        allow get: if isOwner(uid);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid) && validDaily();
        allow update: if isOwner(uid) && validDaily() && dailyGrows('autoActions') && dailyGrows('autoValueCents');
        allow delete: if false;
      }
    }

    // Tudo o que não foi liberado acima é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
