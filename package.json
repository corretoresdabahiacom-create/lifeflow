{
  "name": "lifeflow",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "LifeFlow AI - monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:rules": "pnpm --filter @lifeflow/firebase-rules test:rules",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
